<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================
  Excel Cleaner — IIS configuration
  Drop this file into the SITE ROOT next to login.html.
  See DEPLOY.md for full setup instructions.
  ============================================================
-->
<configuration>
  <system.webServer>

    <!-- Default page: anyone hitting "/" gets the login screen. -->
    <defaultDocument>
      <files>
        <clear />
        <add value="login.html" />
      </files>
    </defaultDocument>

    <!-- Make sure modern font / sourcemap MIME types are served correctly. -->
    <staticContent>
      <remove fileExtension=".woff" />
      <remove fileExtension=".woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".woff"        mimeType="font/woff" />
      <mimeMap fileExtension=".woff2"       mimeType="font/woff2" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>

    <!--
      Block public access to the password-rotation helper folder.
      Admins can still edit the file directly on disk and run it
      with file:// from the host machine.
    -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="tools" />
          <add segment=".git" />
          <add segment=".vscode" />
          <add segment="node_modules" />
        </hiddenSegments>

        <!-- Reject obviously dangerous file types being requested. -->
        <fileExtensions>
          <add fileExtension=".md"  allowed="false" />
          <add fileExtension=".log" allowed="false" />
          <add fileExtension=".bak" allowed="false" />
          <add fileExtension=".config" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!--
      Caching:
        - HTML: never cache (so updates are picked up on hard-refresh).
        - JS/CSS/images/fonts: cache for 7 days; users hit Ctrl+F5 after a deploy.
    -->
    <caching enabled="true" enableKernelCache="true">
      <profiles>
        <add extension=".html" policy="DontCache" kernelCachePolicy="DontCache" />
      </profiles>
    </caching>

    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <httpProtocol>
      <customHeaders>
        <!-- Sensible security headers for an internal static app. -->
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options"        value="SAMEORIGIN" />
        <add name="Referrer-Policy"        value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy"     value="geolocation=(), microphone=(), camera=()" />
      </customHeaders>
    </httpProtocol>

    <!-- HTML is served with no-cache to avoid stale shell after a deploy. -->
    <rewrite>
      <outboundRules>
        <rule name="HtmlNoCache" preCondition="IsHtml">
          <match serverVariable="RESPONSE_Cache_Control" pattern=".*" />
          <action type="Rewrite" value="no-cache, no-store, must-revalidate" />
        </rule>
        <preConditions>
          <preCondition name="IsHtml">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <!-- Friendly error pages for blocked / missing content. -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" />
      <error statusCode="404" path="/login.html" responseMode="ExecuteURL" />
    </httpErrors>

  </system.webServer>
</configuration>
